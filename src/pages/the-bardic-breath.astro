---
import BaseLayout from "src/layouts/BaseLayout.astro";
import CTA from "@components/CTA.astro";
import Landing from "@components/Landing.astro";
import { Picture } from "astro:assets";
import coverImage from "@assets/images/books/the-bardic-breath-cover.jpg";

import { getOptimizedImage } from "@libs/utils";
import landingImage from "@assets/images/landing.jpg";
const optimizedImage = await getOptimizedImage(landingImage);

const amazonLink = "https://amzn.eu/d/0g6xyQON";
---

<BaseLayout
    title="The Bardic Breath — Book by Ronan O'Brien"
    description="The Bardic Breath: Poems and Practices for Reconnecting with Your Ancient Self, by Ronan O'Brien. A collection of poetry and spoken word rooted in the ancient traditions of Ireland's Bards and Druids. Available to order now on Amazon."
    preloadedImage={optimizedImage}
>
    <Landing title="The Bardic Breath" image={landingImage} />
    <section id="book-page">
        <div class="cs-container">
            <div class="cs-image-group">
                <div class="cs-cover">
                    <Picture
                        src={coverImage}
                        alt="The Bardic Breath book cover"
                        width={542}
                        height={813}
                    />
                </div>
            </div>
            <div class="cs-content">
                <span class="cs-topper">Book Release</span>
                <h1 class="cs-title">The Bardic Breath</h1>
                <p class="cs-subtitle">
                    Poems and Practices for Reconnecting with Your Ancient Self
                </p>
                <p class="cs-byline">by Ronan O'Brien</p>

                <p class="cs-lead">
                    The Bardic Breath is the kind of book you never really
                    finish but often keep coming back to. Its poetic insights
                    are not asking you to always agree with them, they are
                    asking more from you to ponder with. The book opens another
                    level of awareness to the type of topics we all experience
                    as humans.
                </p>

                <ul class="cs-pillars">
                    <li class="cs-pillar">
                        <span class="cs-pillar-icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <path d="M24 24c0-2 2-4 4.5-4s5 2.5 5 5.5S30.5 32 26.5 32 18 28.5 18 23.5 22.5 13 28.5 13 40 18 40 25.5 34.5 40 26 40 10 33 10 23 17.5 6 27 6"></path>
                            </svg>
                        </span>
                        <span class="cs-pillar-text">Self<br />Awareness</span>
                    </li>
                    <li class="cs-pillar">
                        <span class="cs-pillar-icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <path d="M24 34V16m0 4c-3-2-7-2-9-6m9 8c3-2 7-2 9-6m-9 2c-2-1.5-4-1.5-6-4m6 6c2-1.5 4-1.5 6-4M24 16c-2-2-3-4-2-8m2 8c2-2 3-4 2-8M14 40c3-3 6-4.5 10-4.5S31 37 34 40m-20-2.5c2.5-1 4-1.5 4-1.5m16 1.5c-2.5-1-4-1.5-4-1.5"></path>
                            </svg>
                        </span>
                        <span class="cs-pillar-text">Embodiment &amp;<br />Connection</span>
                    </li>
                    <li class="cs-pillar">
                        <span class="cs-pillar-icon" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 38c0-10 6-22 24-28-4 12-6 24-18 26m-4 6c1-4 2-7 4-10"></path>
                                <path d="M18 30c4 0 8-1 11-3"></path>
                            </svg>
                        </span>
                        <span class="cs-pillar-text">Creativity &amp;<br />Expression</span>
                    </li>
                </ul>

                <p class="cs-hook">
                    What if the wisdom you're searching for isn't ahead of you,
                    but underneath you, waiting in the breath you take a
                    thousand times a day?
                </p>

                <p>
                    The Bardic Breath is a collection of poetry and spoken word
                    born from years of guided breathing meditations, written by
                    Ronan O'Brien during a time when the world needed grounding
                    more than ever. Rooted in the ancient traditions of
                    Ireland's Bards and Druids, these pages weave together
                    ceremony, nature, and raw human honesty into something you
                    can feel as much as read.
                </p>

                <h2>Inside, you'll find:</h2>
                <ul class="cs-list">
                    <li>
                        Poems that call in the seven directions and reconnect
                        you with the elements
                    </li>
                    <li>
                        Reflections on self love, resilience, and letting go of
                        who you used to be
                    </li>
                    <li>
                        Ceremony scripts you can use alone or in circle with
                        others
                    </li>
                    <li>
                        Meditations on grounding, presence, and the quiet power
                        of your own voice
                    </li>
                    <li>
                        Threads of Celtic symbolism, including Ogham and the
                        wisdom of the Yew, woven through modern insight
                    </li>
                </ul>

                <p>
                    This is not a book you rush through. It's one you return
                    to, breath by breath, page by page, whenever life asks you
                    to slow down and remember who you are.
                </p>
                <p>
                    Whether you're deepening a breathwork practice, exploring
                    your Irish and Celtic roots, or simply looking for words
                    that meet you where you are, The Bardic Breath offers a
                    companion for the journey back to yourself.
                </p>
                <p class="cs-closing">
                    We are the ancestors of the future. This book is an
                    invitation to breathe like you know it.
                </p>

                <blockquote class="cs-quote">
                    <p>
                        "I would genuinely compare this book to an Irish Tao Te
                        Ching. I've studied the Tao Te Ching for years so I
                        genuinely have basis for comparison also. Great to see
                        an Irish Bardic style book like this in circulation."
                    </p>
                    <footer>— Ger Banks</footer>
                </blockquote>
            </div>
        </div>

        <div class="cs-order">
            <span class="cs-order-banner">Available to Order <em>Now</em></span>
            <a
                class="cs-order-bar"
                href={amazonLink}
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="cs-order-label">Order Your Copy on Amazon</span>
                <span class="cs-order-arrow" aria-hidden="true">→</span>
            </a>
        </div>

        <p class="cs-tagline">Breath is poetry. Life is the verse.</p>
    </section>
    <CTA />
</BaseLayout>

<style lang="less">
    /*-- -------------------------- -->
<---          Book Page         -->
<--- -------------------------- -*/

    /* Palette taken from the book's cover & launch graphic */
    @bookGreen: #16241c;
    @bookGreenLight: #1e3128;
    @bookGold: #c4a05a;
    @bookOrange: #de8a2c;
    @bookCream: #f0ead6;

    /* Mobile - 360px */
    @media only screen and (min-width: 0rem) {
        #book-page {
            padding: var(--sectionPadding);
            background-color: @bookGreen;
            overflow: hidden;
            position: relative;
            z-index: 1;

            .cs-container {
                width: 100%;
                max-width: (1280/16rem);
                margin: auto;
                display: flex;
                flex-direction: column;
                align-items: center;
                /* 40px - 64px */
                gap: clamp(2.5rem, 4vw, 4rem);
                position: relative;
            }

            .cs-image-group {
                width: 80%;
                max-width: (400/16rem);
            }

            .cs-cover {
                display: block;
                border-radius: (8/16rem);
                overflow: hidden;
                border: 1px solid fade(@bookGold, 40%);
                box-shadow: 0 (20/16rem) (40/16rem) rgba(0, 0, 0, 0.45);

                img {
                    width: 100%;
                    height: auto;
                    display: block;
                }
            }

            .cs-content {
                text-align: left;
                width: 100%;
                max-width: (738/16rem);
                display: flex;
                flex-direction: column;
                align-items: flex-start;
            }

            .cs-topper {
                letter-spacing: 0.35em;
                text-transform: uppercase;
                color: @bookGold;
            }

            .cs-title {
                margin-bottom: (8/16rem);
                color: @bookCream;
            }

            .cs-subtitle {
                font-size: (20/16rem);
                line-height: 1.4em;
                font-style: italic;
                margin: 0 0 (12/16rem) 0;
                color: @bookGold;
            }

            .cs-byline {
                font-size: (18/16rem);
                font-weight: 700;
                letter-spacing: 0.1em;
                margin: 0 0 (24/16rem) 0;
                color: @bookCream;
            }

            .cs-lead {
                font-size: (19/16rem);
                line-height: 1.6em;
                font-style: italic;
                width: 100%;
                margin: 0 0 (32/16rem) 0;
                padding-bottom: (24/16rem);
                border-bottom: 1px solid fade(@bookGold, 35%);
                color: @bookCream;
            }

            p {
                font-size: var(--bodyFontSize);
                line-height: 1.6em;
                width: 100%;
                margin: 0 0 (16/16rem) 0;
                color: #d9d5c5;
            }

            h2 {
                font-size: (24/16rem);
                font-weight: 700;
                margin: (16/16rem) 0 (16/16rem) 0;
                color: @bookGold;
            }

            .cs-pillars {
                width: 100%;
                margin: 0 0 (32/16rem) 0;
                padding: 0;
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: clamp(0.5rem, 2vw, 1.25rem);
            }

            .cs-pillar {
                list-style: none;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: (12/16rem);
                text-align: center;
            }

            .cs-pillar-icon {
                /* 56px - 80px */
                width: clamp(3.5rem, 8vw, 5rem);
                height: clamp(3.5rem, 8vw, 5rem);
                border: 2px solid @bookGold;
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                color: @bookGold;

                svg {
                    width: 60%;
                    height: 60%;
                }
            }

            .cs-pillar-text {
                font-size: clamp(0.75rem, 1.8vw, 0.9375rem);
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                line-height: 1.4em;
                color: @bookCream;
            }

            .cs-hook {
                font-size: (19/16rem);
                line-height: 1.6em;
                font-style: italic;
                color: @bookGold;
            }

            .cs-list {
                width: 100%;
                margin: 0 0 (24/16rem) 0;
                padding-left: (4/16rem);
                display: flex;
                flex-direction: column;
                gap: (12/16rem);

                li {
                    font-size: var(--bodyFontSize);
                    line-height: 1.5em;
                    list-style: none;
                    color: #d9d5c5;
                    padding-left: (24/16rem);
                    position: relative;

                    &:before {
                        /* gold leaf-dot bullet */
                        content: "";
                        width: (8/16rem);
                        height: (8/16rem);
                        background: @bookGold;
                        border-radius: 50% 0 50% 50%;
                        position: absolute;
                        display: block;
                        top: (8/16rem);
                        left: 0;
                    }
                }
            }

            .cs-closing {
                font-weight: 700;
                color: @bookCream;
            }

            .cs-quote {
                width: 100%;
                margin: (16/16rem) 0 0 0;
                padding: (24/16rem);
                box-sizing: border-box;
                background-color: @bookGreenLight;
                border-left: 4px solid @bookGold;
                border-radius: 0 (16/16rem) (16/16rem) 0;

                p {
                    font-style: italic;
                    margin: 0 0 (12/16rem) 0;
                    color: @bookCream;
                }

                footer {
                    font-size: (14/16rem);
                    font-weight: 700;
                    color: @bookGold;
                }
            }

            .cs-order {
                width: 100%;
                max-width: (700/16rem);
                margin: clamp(2.5rem, 5vw, 4rem) auto 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: (24/16rem);
            }

            .cs-order-banner {
                font-size: clamp(1.25rem, 3.5vw, 1.9375rem);
                font-weight: 700;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                text-align: center;
                width: 100%;
                padding: (16/16rem) (24/16rem);
                box-sizing: border-box;
                background-color: @bookCream;
                /* brush-stroke feel */
                border-radius: (60/16rem) (12/16rem) (60/16rem) (12/16rem);
                color: #1a1a1a;

                em {
                    font-style: normal;
                    color: @bookOrange;
                }
            }

            .cs-order-bar {
                font-size: (17/16rem);
                text-decoration: none;
                font-weight: 700;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                width: 100%;
                padding: (18/16rem) (32/16rem);
                box-sizing: border-box;
                background-color: @bookGreenLight;
                border: 1px solid @bookGold;
                border-radius: (60/16rem);
                color: @bookCream;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: (16/16rem);
                transition:
                    background-color 0.3s,
                    color 0.3s;

                &:hover {
                    background-color: @bookGold;
                    color: #1a1a1a;
                }
            }

            .cs-order-arrow {
                font-size: (22/16rem);
                line-height: 1;
            }

            .cs-tagline {
                font-size: clamp(1rem, 2.5vw, 1.25rem);
                font-style: italic;
                letter-spacing: 0.25em;
                text-transform: uppercase;
                text-align: center;
                margin: clamp(2rem, 4vw, 3rem) auto 0;
                color: @bookGold;
            }
        }
    }

    /* Tablet - 768px */
    @media only screen and (min-width: 48rem) {
        #book-page {
            .cs-container {
                flex-direction: row;
                align-items: flex-start;
                justify-content: space-between;
            }

            .cs-image-group {
                width: 40%;
                max-width: (450/16rem);
                /* keeps the cover in view while scrolling the text */
                position: sticky;
                top: (120/16rem);
                /* prevents flexbox from squishing it */
                flex: none;
            }

            .cs-content {
                width: 55%;
                max-width: (674/16rem);
                flex: none;
            }
        }
    }

    /* Dark Mode — section is already dark by design, keep it identical */
    @media only screen and (min-width: 0rem) {
        body.dark-mode {
            #book-page {
                background-color: @bookGreen;
            }
        }
    }
</style>
